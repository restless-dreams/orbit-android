<?xml version="1.0" encoding="utf-8"?>
<!-- Modo de estudo: as ideias abaixo de cada ideia de um ramo viram cartões para lembrar. Veja TRANSLATING.md. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="study_study">Estudar</string>

