    <plurals name="study_recall_ideas" tools:ignore="ImpliedQuantity">
        <item quantity="one">Lembre a ideia que vem abaixo</item>
        <item quantity="many">Lembre as %1$d ideias que vêm abaixo</item>
        <item quantity="other">Lembre as %1$d ideias que vêm abaixo</item>
    </plurals>
