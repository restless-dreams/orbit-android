    <string name="study_caught_up_title">Tudo em dia</string>
    <string name="study_caught_up">Não há nada para estudar abaixo de %1$s agora. Os próximos cartões voltam %2$s.</string>
    <string name="study_anyway">Estudar mesmo assim</string>
    <string name="study_anyway_explained">Os cartões que você já sabe continuam no cronograma, e os que você errar voltam mais cedo.</string>

