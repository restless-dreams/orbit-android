        <item quantity="one">%1$d para estudar</item>
        <item quantity="many">%1$d para estudar</item>
        <item quantity="other">%1$d para estudar</item>
    </plurals>

    <!-- Os atalhos de teclado ao estudar -->
    <string name="study_shortcuts">Ao estudar</string>
    <string name="study_shortcut_show">Mostrar o que vem abaixo do cartão</string>
