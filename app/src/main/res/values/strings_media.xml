<?xml version="1.0" encoding="utf-8"?>
<!-- Pictures and videos full screen, and the video players. See TRANSLATING.md. -->
<resources>
    <!-- What screen readers say for a picture or video without a description or caption. %1$s is the idea's name. -->
    <string name="media_picture_of">Picture of %1$s</string>
    <string name="media_video_of">Video of %1$s</string>
    <string name="media_picture_missing">This picture isn\'t on this device.</string>
    <string name="media_picture_unreadable">This picture couldn\'t be shown.</string>
    <!-- The play button, for screen readers. %1$s is the video's caption. -->
    <string name="media_play_captioned">Play %1$s</string>
    <!-- The play button of a video without a caption. %1$s is the idea's name. -->
    <string name="media_play_video_of">Play the video of %1$s</string>
    <!-- An animated GIF or WebP's buttons: it plays on its own, unless Android's animations are off. -->
    <string name="media_play_animation">Play the animation</string>
    <!-- A live photo: a still with the few seconds of motion and sound a phone recorded around it. "Live" is its mark, as phones call it. -->
    <string name="media_live">Live</string>
    <string name="media_live_photo">Live photo</string>
    <string name="media_play_live_photo">Play the live photo</string>
    <string name="media_pause_animation">Pause the animation</string>
    <!-- Which picture or video this is, of how many: 2 of 5. -->
    <string name="media_position">%1$d of %2$d</string>
    <string name="media_share_picture">Share the picture</string>
    <string name="media_share_video">Share the video</string>
    <!-- Asked when Orbit couldn't take out of a file being shared what it says beyond what it shows or plays: sharing it anyway is the person's choice, knowing what goes with it. -->
    <string name="media_share_picture_as_it_is_title">Share this picture as it is?</string>
    <string name="media_share_picture_as_it_is_text">Orbit couldn\'t take out where and when it was taken and on what device, so they\'d go with it.</string>
    <string name="media_share_video_as_it_is_title">Share this video as it is?</string>
    <string name="media_share_video_as_it_is_text">Orbit couldn\'t take out where and when it was recorded and on what device, so they\'d go with it.</string>
    <string name="media_share_sound_as_it_is_title">Share this sound as it is?</string>
    <string name="media_share_sound_as_it_is_text">Orbit couldn\'t take out where and when it was recorded and on what device, so they\'d go with it.</string>
    <string name="media_share_as_it_is">Share as it is</string>
    <string name="media_video_missing">This video isn\'t on this device.</string>
    <string name="media_video_unplayable">This video couldn\'t be played here.</string>
    <plurals name="media_seek_back">
        <item quantity="one">Back %d second</item>
        <item quantity="other">Back %d seconds</item>
    </plurals>
    <plurals name="media_seek_forward">
        <item quantity="one">Forward %d second</item>
        <item quantity="other">Forward %d seconds</item>
    </plurals>
    <string name="media_open_in_another_app">Open in another app</string>
    <!-- Asked when a video opened in another app can't go there without what its file says beyond what it shows and plays: opening it anyway is the person's choice, knowing what goes with it, as media_share_video_as_it_is_title asks. -->
    <string name="media_open_video_as_it_is_title">Open this video as it is?</string>
    <string name="media_open_video_as_it_is_text">Orbit couldn\'t take out where and when it was recorded and on what device, so the app you open it in would get them too.</string>
    <string name="media_open_as_it_is">Open as it is</string>
    <!-- When no copy of a video could be made to open in another app, as on a device that's full. -->
    <string name="media_open_video_failed">Orbit couldn\'t make the copy of this video that another app opens. This device may not have room for it.</string>
    <!-- When no copy of a picture, video or sound could be made to share from the full-screen viewer, as on a device that's full. -->
    <string name="media_share_picture_failed">Orbit couldn\'t make the copy of this picture to share. This device may not have room for it.</string>
    <string name="media_share_video_failed">Orbit couldn\'t make the copy of this video to share. This device may not have room for it.</string>
    <string name="media_share_sound_failed">Orbit couldn\'t make the copy of this sound to share. This device may not have room for it.</string>
    <!-- %1$s is the video's site: YouTube or Vimeo. -->
    <string name="media_watch_on">Watch on %1$s</string>
</resources>
