<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; the window only needs the right background while it starts. -->
    <style name="Theme.Orbit" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <!-- Windows over the screen (pictures and videos full screen, a private map's lock) take their bars from
             here: see-through, as enableEdgeToEdge() makes the screen's, on Android 10 to 14 too. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The splash screen: the logo's orbit turns into place while the maps load. -->
    <style name="Theme.Orbit.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_orbit</item>
        <item name="windowSplashScreenAnimationDuration">900</item>
        <item name="postSplashScreenTheme">@style/Theme.Orbit</item>
    </style>

    <!-- The splash light or dark whatever the system is, for Settings → Appearance's Light and Dark (Android 13 and
         later, see startNextIn). -->
    <style name="Theme.Orbit.Starting.Light">
        <item name="windowSplashScreenBackground">@color/splash_background_light</item>
    </style>

    <style name="Theme.Orbit.Starting.Dark">
        <item name="windowSplashScreenBackground">@color/splash_background_dark</item>
    </style>

    <!-- Quick capture: a sheet over whatever is on screen, which draws its own scrim. -->
    <style name="Theme.Orbit.Capture">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
