    <string name="audio_copying_the_sound_percent">Copying the sound… %1$s</string>
    <string name="audio_sound_unreadable">That sound couldn\'t be read.</string>

    <!-- The players' buttons, for screen readers and as tooltips. -->
    <string name="audio_play">Play</string>
    <string name="audio_pause">Pause</string>
    <string name="audio_mute">Turn the sound off</string>
    <string name="audio_unmute">Turn the sound on</string>
    <string name="audio_stop">Stop the sound</string>
    <string name="audio_open_full_screen">Open the sound full screen</string>
    <string name="audio_share">Share the sound</string>
    <!-- The slider that moves a sound: for screen readers. -->
    <string name="audio_position">Position</string>
    <!-- Where a sound is: %1$s is the time it's at, %2$s how long it is, such as 0:42 of 3:10. -->
    <string name="audio_time_of">%1$s of %2$s</string>
    <string name="audio_unplayable">This sound can\'t be played.</string>
    <!-- A sound of the map's that isn't in its folder: left out of a backup that was full, say. -->
    <string name="audio_missing">This sound isn\'t on this device.</string>

    <!-- The toolbar's and the long-press menu's button for the idea in focus's sound: %1$s is the idea. -->
    <string name="audio_play_the_sound_in">Play the sound in %1$s</string>
