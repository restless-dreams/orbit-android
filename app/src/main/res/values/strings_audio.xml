    <!-- The recorder. %1$s is the idea the memo goes on. -->
    <string name="audio_recorder_for">For %1$s</string>
    <string name="audio_tap_to_record">Tap to record</string>
    <string name="audio_recording">Recording</string>
    <string name="audio_paused">Paused</string>
    <string name="audio_record">Record</string>
    <string name="audio_pause_recording">Pause the recording</string>
    <string name="audio_resume_recording">Go on recording</string>
    <string name="audio_finish_recording">Finish</string>
    <string name="audio_discard">Discard</string>
    <string name="audio_save">Save</string>
    <string name="audio_saving">Saving…</string>
    <string name="audio_discard_title">Discard this voice memo?</string>
    <string name="audio_discard_body">What you recorded won\'t be kept.</string>
    <string name="audio_keep_it">Keep it</string>
    <string name="audio_needs_the_microphone">Orbit needs the microphone to record a voice memo. You can allow it in Settings.</string>
    <string name="audio_no_microphone">This device has no microphone Orbit can record with.</string>
    <string name="audio_recording_failed">The recording stopped. Another app may be using the microphone.</string>
    <string name="audio_longest_memo">That\'s as long as a voice memo can be, so it stopped there.</string>
    <string name="audio_map_room_reached">That\'s all the room this map has left, so the memo stopped there.</string>
    <!-- %1$s is what the map's pictures, videos and sounds come to, such as 950 MB or 1 GB. -->
    <string name="audio_map_full">This map\'s pictures, videos and sounds come to %1$s, all a map can carry when it\'s shared or backed up. Take one off to make room for a voice memo.</string>
    <!-- After a voice memo joins its idea, with Undo: %1$s is the idea. -->
    <string name="audio_memo_saved">Saved the voice memo in %1$s</string>
    <!-- Under the recorder's clock once a take is finished: listen to it, then keep it or record again. -->
    <string name="audio_ready_to_save">Ready to save</string>

    <!-- Sounds a map can't take. Sizes read as data_megabytes and data_gigabytes do: 250 MB, 1 GB. -->
    <!-- %1$s is the sound's size, %2$s the most a sound can be. -->
    <string name="data_sound_too_big">That sound is %1$s, and a map keeps sounds of up to %2$s, so it can still go to your other devices. Trim it, or add it as a web address.</string>
    <!-- %1$s is the most a sound can be. -->
    <string name="data_sound_past_limit">That sound is more than %1$s, and a map keeps sounds of up to that, so it can still go to your other devices. Trim it, or add it as a web address.</string>
    <!-- %1$s is what the map's pictures, videos and sounds come to, %2$s the most they can. -->
    <string name="data_sound_past_map_room">This map\'s pictures, videos and sounds come to %1$s already. With this sound they\'d be more than the %2$s a map can carry when it\'s shared or backed up. Choose a shorter one, or add it as a web address.</string>
    <!-- %1$s is the sound's type as computers name it, such as audio/amr. -->
    <string name="data_sound_kind_refused">Orbit keeps sounds as MP3, MP4, AAC, Ogg, Opus, WAV, FLAC or WebM files, and this one is %1$s.</string>
    <string name="data_sound_kind_unknown">Orbit keeps sounds as MP3, MP4, AAC, Ogg, Opus, WAV, FLAC or WebM files, and this one is of a kind it doesn\'t know.</string>
    <string name="data_no_room_for_sound">There isn\'t room on this device for that sound.</string>
</resources>
