<!-- Sounds on ideas: voice memos recorded in Orbit, sounds from the phone or the web, and the players that play them. See TRANSLATING.md. -->
<resources>
    <!-- What a sound is called when it has no caption. -->
    <string name="audio_sound">Sound</string>
    <string name="audio_voice_memo">Voice memo</string>
    <!-- For screen readers, a sound in the viewer without a caption: %1$s is its idea. -->
    <string name="audio_sound_of">Sound of %1$s</string>

    <!-- The editor's section for an idea's sound. -->
    <string name="audio_section">Sound</string>
    <string name="audio_record_a_voice_memo">Record a voice memo</string>
    <string name="audio_choose_a_sound">Choose a sound file</string>
    <string name="audio_or_a_sound_address">Or a sound\'s web address</string>
    <string name="audio_sound_address">Sound address</string>
    <string name="audio_record_again">Record again</string>
    <string name="audio_copying_the_sound">Copying the sound…</string>
