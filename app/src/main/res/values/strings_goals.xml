    <!-- A goal's numbers in words. %1$s is where it is and %2$s what it started at or is after, as amounts. -->
    <string name="goal_no_target_yet">No target yet</string>
    <!-- %3$s is a percentage. -->
    <string name="goal_summary_paying_off">%1$s left of %2$s · %3$s paid</string>
    <string name="goal_summary_paid_off">%1$s left of %2$s · Paid off</string>
    <string name="goal_summary_reached">%1$s of %2$s · Reached</string>
    <!-- %3$s is a percentage. -->
    <string name="goal_summary_saving_up">%1$s of %2$s · %3$s</string>
    <!-- %3$s is a percentage, and %4$s the amount still to go, which picks the plural. -->
    <plurals name="goal_summary_saving_up_to_go">
        <item quantity="one">%1$s of %2$s · %3$s · %4$s to go</item>
        <item quantity="other">%1$s of %2$s · %3$s · %4$s to go</item>
    </plurals>
    <!-- %3$s is how many are still to go, which picks the plural. -->
    <plurals name="goal_summary_counting_to_go">
        <item quantity="one">%1$s of %2$s · %3$s to go</item>
        <item quantity="other">%1$s of %2$s · %3$s to go</item>
    </plurals>
    <string name="goal_amount_of_target">%1$s of %2$s</string>
    <!-- Briefly, in the outline: what's left to pay, and a count as 2/5. -->
    <string name="goal_brief_left">%1$s left</string>
    <string name="goal_brief_counting">%1$s/%2$s</string>

    <!-- How many of the goals and to-dos under an idea are done (%1$s) of how many (%2$s), and how far along they are (%3$s). The plural follows %1$s. -->
    <plurals name="goal_progress_done">
        <item quantity="one">%1$s of %2$s done · %3$s</item>
        <item quantity="other">%1$s of %2$s done · %3$s</item>
    </plurals>
    <!-- The same, when they're all goals. -->
    <plurals name="goal_progress_reached">
        <item quantity="one">%1$s of %2$s reached · %3$s</item>
        <item quantity="other">%1$s of %2$s reached · %3$s</item>
    </plurals>
    <!-- %1$s says how far along they are: "2 of 4 done · 63%". -->
    <string name="goal_follows_the_ideas_under_it">Follows the goals and to-dos under it: %1$s</string>
    <string name="goal_no_target_follows_the_ideas_under_it">No target yet. Without one, it follows the goals and to-dos under it.</string>
    <string name="goal_no_to_dos_or_goals_under_it">No to-dos or goals under it yet.</string>
