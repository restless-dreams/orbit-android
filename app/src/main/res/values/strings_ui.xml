<?xml version="1.0" encoding="utf-8"?>
<!-- Pieces of the app's screens used in many places: keys, colors, sharing, notices. See TRANSLATING.md. -->
<resources>
    <!-- What the launcher says when a shortcut to a deleted map is tapped. -->
    <string name="ui_map_deleted">This map was deleted</string>
    <!-- The share sheet's title. %1$s is what's shared: a map's or idea's name. -->
    <string name="ui_share_named">Share “%1$s”</string>
    <string name="ui_no_icon">No icon</string>
    <!-- The sheet for a map's tags. %1$s is the map's title. -->
    <string name="ui_tags_for">Tags for %1$s</string>
    <string name="ui_new_tag">New tag</string>
    <string name="ui_add_tag">Add</string>
    <string name="ui_tags_help">Tags group your maps however you think of them, like Work or Japan trip. A map can have several. Type one to add it.</string>
    <!-- A map card's tags, as screen readers say them. %1$s is the list. -->
    <string name="ui_tags_list">Tags: %1$s</string>
    <!-- The icon sheet's search, which finds emoji by their names and keywords. -->
    <string name="ui_search_emoji">Search emoji</string>
    <string name="ui_clear_the_search">Clear the search</string>
    <!-- %1$s is what was typed. -->
    <string name="ui_no_emoji_found">No emoji for “%1$s”</string>
    <!-- What a long press on a found emoji does, as TalkBack says it. -->
    <string name="ui_choose_a_skin_tone">Choose a skin tone</string>

    <!-- When the phone's WebView is too old to draw maps. %1$s is its name, such as Android System WebView. -->
    <string name="ui_web_view_update_to_see_maps">Update %1$s to see your maps</string>
    <!-- %1$s is the WebView's name, %2$d its Chromium version, %3$d the version Orbit needs. -->
    <string name="ui_web_view_too_old">Orbit draws maps with %1$s, and this phone\'s is too old: Chromium %2$d, where Orbit needs %3$d or later. Update it from your app store, or with a system update, and your maps will show. They\'re all still here.</string>
    <string name="ui_web_view_update">Update %1$s</string>

    <!-- A button's name with the keys that do the same, as a hint shows them: Undo (Ctrl+Z). -->
    <string name="ui_hint_with_keys">%1$s (%2$s)</string>
    <!-- Between two ways to press a shortcut, in the list of shortcuts. -->
    <string name="ui_keys_or">or</string>
    <!-- Two ways to press a shortcut, as screen readers say them: Ctrl Y or Ctrl Shift Z. -->
    <string name="ui_keys_either">%1$s or %2$s</string>
