<?xml version="1.0" encoding="utf-8"?>
<!-- Exporting and sharing a map: its pictures, drawings and files. See TRANSLATING.md. -->
<resources>
    <string name="export_and_share">Export and share</string>
    <!-- The title a map is exported and shared under when it has none of its own. -->
    <string name="export_default_title">Map</string>

    <!-- Which part of the map pictures show, and whether they have a background. -->
    <string name="export_pictures_show">Pictures show</string>
    <string name="export_this_view">This view</string>
    <string name="export_whole_map">Whole map</string>
    <string name="export_as_it_opens">As it opens</string>
    <string name="export_background">Background</string>

    <!-- The ways to take the map out of the app, each with what it is. -->
    <string name="export_web_page_description">Flies in any browser, even offline, and presents</string>
    <string name="export_pdf">PDF or print</string>
    <string name="export_pdf_description">The map, its outline and every note, on paper or as a PDF</string>
    <string name="export_picture">Picture</string>
    <string name="export_picture_description">A PNG, drawn by Orbit</string>
    <string name="export_drawing">Drawing</string>
    <string name="export_drawing_description">An SVG that stays sharp at any size</string>
    <string name="export_markdown" translatable="false">Markdown</string>
    <string name="export_markdown_description">The map as orbit-md, to edit anywhere</string>
    <string name="export_yaml" translatable="false">YAML</string>
    <string name="export_yaml_description">The map as data, for apps and scripts</string>
    <string name="export_opml" translatable="false">OPML</string>
    <string name="export_opml_description">The outline, for outliners and other mind map apps</string>
    <string name="export_zip">Zip</string>
    <string name="export_zip_description">The markdown with the pictures, videos, sounds and files it holds</string>

    <!-- Each way out as a sentence names it, after Save, Share or Copy: “Save the web page”. -->
    <string name="export_web_page_named">the web page</string>
    <string name="export_pdf_named">the PDF</string>
    <string name="export_picture_named">the picture</string>
    <string name="export_drawing_named">the drawing</string>
    <string name="export_markdown_named">the markdown</string>
    <string name="export_yaml_named">the YAML</string>
    <string name="export_opml_named">the OPML</string>
    <string name="export_zip_named">the zip</string>
    <!-- What TalkBack reads for each way's buttons. %1$s is a way as a sentence names it, from above: "the picture". -->
    <string name="export_copy_format">Copy %1$s</string>
    <string name="export_save_format">Save %1$s</string>
    <string name="export_share_format">Share %1$s</string>
    <!-- What TalkBack reads for the PDF way's button, which opens Android's print dialog. -->
    <string name="export_print">Print or save as PDF</string>
    <!-- The words on each way's buttons, under its description. -->
    <string name="export_copy">Copy</string>
    <string name="export_save">Save</string>
    <string name="export_share">Share</string>
    <string name="export_print_button">Print</string>
    <!-- Under a way, once it's copied, on Android 12 and earlier, which don't say so themselves. -->
    <string name="export_copied">Copied</string>

    <!-- When a map couldn't be laid out to print. -->
    <string name="export_print_failed">The map couldn’t be laid out for printing</string>
    <!-- Said once Android's print dialog opens, when pictures of the map couldn't be loaded into the print: from the web, on a phone that can't reach it now, say. -->
    <plurals name="export_print_without_pictures">
        <item quantity="one">%d picture couldn’t be loaded, so it’s left out of the print</item>
        <item quantity="other">%d pictures couldn’t be loaded, so they’re left out of the print</item>
    </plurals>

    <!-- In a way's row, when its file couldn't be made, shared, saved or copied. -->
    <string name="export_could_not_make">Orbit couldn’t make this file. Try again in a moment.</string>
    <string name="export_no_room">Orbit couldn’t make this file. Is this device’s storage full?</string>
    <string name="export_could_not_save">Orbit couldn’t save this file there. Try another place.</string>
    <string name="export_too_much_to_copy">This is too much to copy at once. Share or save it instead.</string>
    <!-- In the YAML and OPML rows of a map Orbit only shows, which it won't write anew. -->
    <string name="export_newer_map_not_written">A newer version of Orbit made this map, so this one can’t write it this way. Update Orbit, or export it as markdown.</string>
    <string name="export_unreadable_map_not_written">Orbit couldn’t read all of this map, so it can’t write it this way. Fix the text, or export it as markdown.</string>
    <!-- The same, in the markdown and OPML rows of a map written in YAML, which can always be exported as its own YAML. -->
    <string name="export_newer_yaml_map_not_written">A newer version of Orbit made this map, so this one can’t write it this way. Update Orbit, or export it as YAML.</string>
    <string name="export_unreadable_yaml_map_not_written">Orbit couldn’t read all of this map, so it can’t write it this way. Fix the text, or export it as YAML.</string>
</resources>
