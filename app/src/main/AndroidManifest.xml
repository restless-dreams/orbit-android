<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Presentations and maps for the devices in the room, over the local network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ideas said aloud, while the + is held. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Private maps open with the phone's own fingerprint, face or screen lock, through Android's prompt. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Reminders when ideas' dates come, asked for on Android 13 and later as the first date is set. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Reminders set again after the phone restarts: Android forgets every app's alarms as it shuts down. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        WorkManager, which Glance runs the widgets on, adds three more to the built app: RECEIVE_BOOT_COMPLETED
        too, to schedule the widgets' updates again after the phone restarts; WAKE_LOCK, so an update isn't cut
        short by the phone sleeping; and FOREGROUND_SERVICE, for urgent work on Android 11 and earlier. The stores
        list them all. Reminders ask for no exact alarms: they come within minutes of their moment (see
        reminders/AndroidReminders.kt).
    -->

    <!--
        Neither is needed: without a microphone ideas are typed, and keyboards, mice and
        styluses work everywhere, so Chromebooks and tablets without them can install Orbit.
    -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
        A backup comes back onto any version of Orbit, an older one too (an F-Droid build a
        release behind, say): each opens what a newer one left without harm, keeping what it
        doesn't know and only showing what it can't change (docs/architecture/files-and-upgrades.md).
    -->
    <application
        android:name=".OrbitApplication"
        android:allowBackup="true"
        android:backupAgent=".data.OrbitBackupAgent"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:fullBackupOnly="true"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:restoreAnyVersion="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Orbit.Starting"
        tools:targetApi="33">
        <!--
            Compose follows rotation, resizing, folding and dark mode on its own, so the
            activity stays: the map's WebView keeps its place instead of loading again.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                Open markdown and YAML files, zips of maps, other apps' maps (OPML, FreeMind and Freeplane, XMind), and
                text files, which make maps as shared text does: markdown and YAML files an app calls plain text stay
                maps as written. The types in data/MapFileTypes.kt, which MapFileTypesTest checks this against.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="text/yaml" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/x-zip" />
                <data android:mimeType="text/x-opml" />
                <data android:mimeType="application/x-opml" />
                <data android:mimeType="application/x-freemind" />
                <data android:mimeType="application/vnd.xmind.workbook" />
                <data android:mimeType="application/x-xmind" />
                <data android:mimeType="application/xmind" />
            </intent-filter>
            <!--
                OPML files and XMind workbooks have no type of their own on Android: file managers open them as
                application/octet-stream, so they're known by their names. pathSuffix takes any name; the patterns
                cover older Android, whose matching stops at the first dot.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathSuffix=".opml" />
                <data android:pathSuffix=".xmind" />
                <data android:pathPattern=".*\\.opml" />
                <data android:pathPattern=".*\\..*\\.opml" />
                <data android:pathPattern=".*\\..*\\..*\\.opml" />
                <data android:pathPattern=".*\\.xmind" />
                <data android:pathPattern=".*\\..*\\.xmind" />
                <data android:pathPattern=".*\\..*\\..*\\.xmind" />
            </intent-filter>
            <!-- Text, markdown and YAML files, zips of maps and other apps' maps shared to Orbit become maps. -->
            <intent-filter android:label="@string/share_new_map">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="text/yaml" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/x-zip" />
                <data android:mimeType="text/x-opml" />
                <data android:mimeType="application/x-opml" />
                <data android:mimeType="application/x-freemind" />
                <data android:mimeType="application/vnd.xmind.workbook" />
                <data android:mimeType="application/x-xmind" />
                <data android:mimeType="application/xmind" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            Files of any kind shared to Orbit join an idea: the one in focus on the map that's open,
            or a new map's, named after the first. MainActivity tells them by this alias.
        -->
        <activity-alias
            android:name=".AttachFiles"
            android:exported="true"
            android:label="@string/share_attach_to_idea"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity-alias>

        <!--
            Quick capture: ideas added to a map without opening it, from the Quick Settings
            tile, a home screen widget's +, or text shared from another app.
        -->
        <activity
            android:name=".capture.CaptureActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/capture_label"
            android:taskAffinity=""
            android:theme="@style/Theme.Orbit.Capture"
            android:windowSoftInputMode="adjustResize">
            <intent-filter android:label="@string/share_add_to_map">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <service
            android:name=".capture.CaptureTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_capture"
            android:label="@string/tile_capture"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- A map on the home screen. -->
        <receiver
            android:name=".widget.MapWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/map_widget_info" />
        </receiver>
        <activity
            android:name=".widget.MapWidgetConfigureActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Orbit">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- A widget put on the home screen from a map's menu: which map it shows. -->
        <receiver
            android:name=".widget.WidgetPinnedReceiver"
            android:exported="false" />

        <!--
            Reminders: their alarm, and the phone starting again, its clock or time zone changing, and Orbit
            updated, which all leave alarms to set again. Only Android and Orbit itself send them.
        -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Something chosen in a share sheet Orbit opened: that share stays as private maps lock. -->
        <receiver
            android:name=".ui.ShareChosenReceiver"
            android:exported="false" />

        <!-- WorkManager starts when Glance's widgets first need it, with OrbitApplication's settings, so storage it can't use never stops Orbit. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Exports shared with other apps: pictures, files and zips from the cache. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>
    </application>

    <queries>
        <!-- Android's own screen casting, for showing a presentation on a TV without a Cast receiver. -->
        <intent>
            <action android:name="android.settings.CAST_SETTINGS" />
        </intent>
        <!-- The phone's speech service, or another app's listening screen, for ideas said aloud. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!-- The phone's app store, whichever it is, for a WebView too old to draw maps. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

</manifest>
