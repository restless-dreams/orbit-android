<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Presentations and maps for the devices in the room, over the local network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ideas said aloud, while the + is held. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        Neither is needed: without a microphone ideas are typed, and keyboards, mice and
        styluses work everywhere, so Chromebooks and tablets without them can install Orbit.
    -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".OrbitApplication"
        android:allowBackup="true"
        android:backupAgent=".data.OrbitBackupAgent"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:fullBackupOnly="true"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Orbit.Starting"
        tools:targetApi="33">
        <!--
            Compose follows rotation, resizing, folding and dark mode on its own, so the
            activity stays: the map's WebView keeps its place instead of loading again.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open markdown and YAML files, and zips of maps, from other apps. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="application/yaml" />
                <data android:mimeType="text/yaml" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
            <!-- Text, files and zips of maps shared to Orbit become maps. -->
            <intent-filter android:label="@string/share_new_map">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            Quick capture: ideas added to a map without opening it, from the Quick Settings
            tile, a home screen widget's +, or text shared from another app.
        -->
        <activity
            android:name=".capture.CaptureActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/capture_label"
            android:taskAffinity=""
            android:theme="@style/Theme.Orbit.Capture"
            android:windowSoftInputMode="adjustResize">
            <intent-filter android:label="@string/share_add_to_map">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <service
            android:name=".capture.CaptureTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_capture"
            android:label="@string/tile_capture"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- A map on the home screen. -->
        <receiver
            android:name=".widget.MapWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/map_widget_info" />
        </receiver>
        <activity
            android:name=".widget.MapWidgetConfigureActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Orbit">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- A widget put on the home screen from a map's menu: which map it shows. -->
        <receiver
            android:name=".widget.WidgetPinnedReceiver"
            android:exported="false" />

        <!-- Exports shared with other apps: pictures, files and zips from the cache. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>
    </application>

    <queries>
        <!-- Android's own screen casting, for showing a presentation on a TV without a Cast receiver. -->
        <intent>
            <action android:name="android.settings.CAST_SETTINGS" />
        </intent>
        <!-- The phone's speech service, or another app's listening screen, for ideas said aloud. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!-- The phone's app store, whichever it is, for a WebView too old to draw maps. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

</manifest>
